# ===== 爱心小食堂 后端配置 =====
# 复制这个文件为 .env 后按需修改

# 监听地址与端口
HOST=0.0.0.0
PORT=8801

# JWT 签名密钥（生产环境务必改成随机字符串！）
SECRET_KEY=please-change-this-to-a-random-secret-string
# Token 有效期（小时）
TOKEN_EXPIRE_HOURS=720

# 数据库文件路径（相对 backend/ 目录）
DATABASE_URL=sqlite:///./food_baby.db

# 初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 强烈建议：首次登录后立刻在后台「修改密码」页面改掉

# 允许跨域的前端地址（本地开发用，逗号分隔；生产用 Nginx 同源反代可留空）
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# 上传文件目录与访问前缀
UPLOAD_DIR=app/static/uploads
UPLOAD_URL_PREFIX=/uploads

# 图片压缩参数
IMAGE_MAX_SIDE=1200
IMAGE_THUMB_SIDE=400
IMAGE_JPEG_QUALITY=86

# 未开始做的订单超过多少分钟自动取消
ORDER_AUTO_CANCEL_MINUTES=120

# 自动取消巡检间隔（秒）
AUTO_CANCEL_INTERVAL_SECONDS=60
